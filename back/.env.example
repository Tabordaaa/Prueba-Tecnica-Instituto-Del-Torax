# Copiar este archivo como .env y ajustar los valores

# Puerto de la API
PORT=3000

# Conexion MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=instituto_del_torax

# JWT (cambiar la clave en cualquier entorno real)
JWT_SECRET=cambia-esta-clave-por-una-secreta
# Tiempo de vida del token en segundos (3600 = 1 hora, 86400 = 1 dia)
JWT_EXPIRES_IN=3600

# Hash de contrasenas
BCRYPT_SALT_ROUNDS=10

# Usuario administrador que crea el comando "npm run seed"
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@instituto.com
ADMIN_PASS=Admin1234
